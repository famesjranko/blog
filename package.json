{
	"name": "personal-blog",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Tiny custom static-site pipeline: Markdown -> TypeScript -> HTML.",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsx src/build.ts",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.static.json",
		"lint": "biome lint --error-on-warnings .",
		"guard": "tsx scripts/guard.ts",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "vitest run",
		"images": "tsx scripts/optimize-images.ts",
		"images:check": "tsx scripts/optimize-images.ts --check",
		"check": "make check"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"markdown-it": "^14.1.0",
		"tinyglobby": "^0.2.12",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^22.0.0",
		"sharp": "^0.35.4",
		"tsx": "^4.19.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	}
}
