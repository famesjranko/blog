{
	"name": "personal-blog",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Tiny custom static-site pipeline: Markdown -> TypeScript -> HTML.",
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"prebuild": "npm run images",
		"build": "tsx src/build.ts",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.static.json && tsc -p tsconfig.browser.json",
		"lint": "biome lint --error-on-warnings .",
		"guard": "tsx scripts/guard.ts",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "vitest run",
		"test:browser": "playwright test",
		"images": "tsx scripts/optimize-images.ts",
		"images:check": "tsx scripts/optimize-images.ts --check",
		"check": "make check",
		"prepare": "git config core.hooksPath scripts/hooks"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"markdown-it": "^14.1.0",
		"tinyglobby": "^0.2.12",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "1.64.0",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^22.0.0",
		"sharp": "^0.35.5",
		"tsx": "^4.23.15",
		"typescript": "^5.9.0",
		"vitest": "^5.0.4"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
